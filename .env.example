# ===========================================
# AI Meeting Copilot - Environment Variables
# ===========================================

# -----------------
# Database
# -----------------
DATABASE_URL=postgresql://user:password@localhost:5432/ai_meeting_copilot

# -----------------
# Authentication
# -----------------
# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Session secret for JWT/cookies
SESSION_SECRET=

# -----------------
# AI Services
# -----------------
# LLM provider: groq (default, needs GROQ_API_KEY) | claude-code (local `claude`
# CLI subscription, no API key — only when the backend runs on your own machine).
LLM_PROVIDER=groq
# Groq API for LLM inference
GROQ_API_KEY=
# Optional when LLM_PROVIDER=claude-code:
# CLAUDE_CODE_MODEL=
# CLAUDE_CODE_PATH=claude

# Google Gemini API for embeddings
GOOGLE_GEMINI_API_KEY=

# -----------------
# Speech-to-Text
# -----------------
# Deepgram API for real-time transcription
DEEPGRAM_API_KEY=

# -----------------
# Vector Database
# -----------------
# Embeddings are stored in SQLite (see DATABASE_URL). No separate vector
# database (Qdrant, etc.) is required.

# -----------------
# File Storage
# -----------------
# Cloudinary for audio/media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------
# Integrations
# -----------------
# Slack Bot Token
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Email Service (SendGrid)
SENDGRID_API_KEY=
FROM_EMAIL=

# -----------------
# Application
# -----------------
NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# -----------------
# Optional: Web Enrichment / Guest Research
# -----------------
# The free base (email domain->company, Gravatar, GitHub) needs no config.
# For attendee intelligence (LinkedIn, etc.)
SERPER_API_KEY=
# LinkedIn layer: none (default) | serper (uses SERPER_API_KEY) | pdl (needs PDL_API_KEY)
ENRICHMENT_PROVIDER=none
PDL_API_KEY=
GITHUB_TOKEN=
ENRICHMENT_CACHE_TTL_DAYS=30
