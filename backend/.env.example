# Backend Environment Variables
# Copy this to .env and fill in your actual values

DATABASE_URL="file:./dev.db"

# Google OAuth — login uses GOOGLE_REDIRECT_URI; integrations (Calendar/Gmail) use GOOGLE_INTEGRATIONS_REDIRECT_URI.
# In Google Cloud Console → Credentials → OAuth 2.0 Client, add BOTH redirect URIs (exact match, no trailing slash).
# Also enable Google Calendar API (+ Gmail API) and add scopes + test users on the OAuth consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_INTEGRATIONS_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# JWT/Session
SESSION_SECRET=
JWT_SECRET=

# AI Services
# LLM provider for summaries/action items/chat/agent:
#   groq        (default) — GROQ API, requires GROQ_API_KEY below
#   claude-code           — local `claude` CLI subscription, no API key needed
#                           (only works where the backend runs on your own
#                            machine with Claude Code installed & logged in)
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional overrides when LLM_PROVIDER=claude-code:
# CLAUDE_CODE_MODEL=          # e.g. claude-opus-4-8 (defaults to the CLI's model)
# CLAUDE_CODE_PATH=claude     # path to the claude binary if not on PATH
GOOGLE_GEMINI_API_KEY=

# Speech-to-Text
DEEPGRAM_API_KEY=

# Vector Store: embeddings are stored in SQLite (DATABASE_URL) — no separate
# vector database is required.

# File Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Integrations
# Slack is an OAuth app install ("Add to Slack"), not a pasted bot token.
# Create the app at https://api.slack.com/apps, then copy Client ID / Client
# Secret / Signing Secret from Basic Information.
# SLACK_REDIRECT_URI must match the Redirect URL in the app's OAuth & Permissions
# page exactly (no trailing slash).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/integrations/slack/callback
SENDGRID_API_KEY=
FROM_EMAIL=

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Optional
SERPER_API_KEY=

# Guest research (enrich meeting attendees from the internet).
# The free base (email domain->company, Gravatar, GitHub) needs NO config.
# Optionally enable a "LinkedIn layer" for richer, structured profiles:
#   ENRICHMENT_PROVIDER=none    (default) free base only
#   ENRICHMENT_PROVIDER=serper  anchored web search (uses SERPER_API_KEY above, free credits)
#   ENRICHMENT_PROVIDER=pdl      People Data Labs person enrichment (free ~100/mo, needs PDL_API_KEY)
ENRICHMENT_PROVIDER=none
PDL_API_KEY=
# Optional: raises GitHub API rate limits (still free).
GITHUB_TOKEN=
# Days to cache an enriched Contact before re-researching.
ENRICHMENT_CACHE_TTL_DAYS=30
