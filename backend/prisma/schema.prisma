// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema
//
// NOTE: This project uses SQLite for easy open-source local setup.
// SQLite/Prisma limitations that shape this schema:
//   - No scalar list columns (`String[]`) -> stored as JSON-encoded `String`
//     columns (see backend/src/lib/json-list.ts for the get/set convention).
//   - No native enums -> stored as `String` columns; the allowed values live in
//     backend/src/lib/enums.ts (mirrored by the zod schemas in lib/schemas.ts).
//   - No `@db.Text` native attribute -> `String` already maps to TEXT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========================================
// User & Authentication
// ========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?

  // Google OAuth fields
  googleId      String?   @unique
  googleEmail   String?
  accessToken   String?
  refreshToken  String?

  // Preferences
  timezone      String    @default("UTC")
  language      String    @default("en")
  // JSON blob of UI/AI preferences (see lib/preferences.ts). Stored as a string
  // like the app's other SQLite JSON fields.
  preferences   String?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  meetings      Meeting[]
  chatMessages  AIChatMessage[]
  notes         MeetingNote[]
  integrations  Integration[]

  @@index([email])
  @@index([googleId])
}

// ========================================
// Integrations
// ========================================

model Integration {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // IntegrationProvider: GOOGLE_CALENDAR | GMAIL | SLACK | MICROSOFT
  provider        String

  // OAuth tokens
  accessToken     String?
  refreshToken    String?
  tokenExpiry     DateTime?

  // Scopes granted (JSON-encoded string[])
  scopes          String    @default("[]")

  // Connection status
  isActive        Boolean   @default(true)

  // Provider-specific configuration
  metadata        Json?

  // Timestamps
  connectedAt     DateTime  @default(now())
  lastSyncAt      DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([isActive])
}

// ========================================
// Meetings
// ========================================

model Meeting {
  id                String    @id @default(cuid())
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime?
  duration          Int?      // Duration in seconds
  // MeetingStatus: SCHEDULED | LIVE | PROCESSING | COMPLETED | CANCELLED | FAILED
  status            String    @default("SCHEDULED")

  // Recording metadata
  audioUrl          String?
  audioDuration     Int?      // Duration in seconds
  recordingStarted  DateTime?
  recordingEnded    DateTime?

  // Platform info
  platform          String?   // "zoom", "meet", "teams", "in-person"
  platformMeetingId String?
  platformUrl       String?

  // AI-generated content
  aiSummary         String?
  summaryHtml       String?
  // JSON-encoded string[]
  keyDecisions      String    @default("[]")
  risks             String    @default("[]")
  highlights        String    @default("[]")
  // Optional processing error message (set when status = FAILED)
  processingError   String?

  // Vector embedding for semantic search
  embeddingId       String?   @unique

  // Relations
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  attendees         MeetingAttendee[]
  transcript        TranscriptLine[]
  actionItems       ActionItem[]
  chatMessages      AIChatMessage[]
  notes             MeetingNote[]
  tags              MeetingTag[]

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([startTime])
  @@index([status])
}

// ========================================
// Meeting Attendees
// ========================================

model MeetingAttendee {
  id              String    @id @default(cuid())
  meetingId       String
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  name            String
  email           String?
  role            String?   // "organizer", "required", "optional"

  // Enrichment data
  linkedinUrl     String?
  company         String?
  title           String?
  bio             String?
  enrichedAt      DateTime?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([meetingId])
  @@index([email])
}

// ========================================
// Transcript
// ========================================

model TranscriptLine {
  id              String    @id @default(cuid())
  meetingId       String
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  speaker         String
  text            String
  timestamp       String    // Format: "00:12:34"
  timestampSeconds Int      // Seconds from start

  // Metadata
  confidence      Float?    // 0.0 to 1.0
  highlighted     Boolean   @default(false)

  // Vector embedding for semantic search (Qdrant point UUID)
  embeddingId     String?

  // Timestamps
  createdAt       DateTime  @default(now())

  @@index([meetingId])
  @@index([timestampSeconds])
}

// ========================================
// Action Items
// ========================================

model ActionItem {
  id              String    @id @default(cuid())
  meetingId       String
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  task            String
  assignee        String?
  dueDate         DateTime?
  // Priority: LOW | MEDIUM | HIGH | URGENT
  priority        String    @default("MEDIUM")
  // ActionStatus: PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  status          String    @default("PENDING")

  // Context
  timestamp       String?   // Where in meeting it was mentioned
  context         String?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  @@index([meetingId])
  @@index([status])
  @@index([dueDate])
}

// ========================================
// AI Chat Messages (In-Meeting + Post-Meeting)
// ========================================

model AIChatMessage {
  id              String    @id @default(cuid())
  meetingId       String?
  meeting         Meeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  question        String
  answer          String

  // Context used for answer
  contextType     String?   // "transcript", "summary", "action_items", "history"
  contextSnippet  String?

  // Metadata
  model           String?   // Which LLM was used
  tokensUsed      Int?
  responseTime    Int?      // Milliseconds

  // Timestamps
  createdAt       DateTime  @default(now())

  @@index([meetingId])
  @@index([userId])
}

// ========================================
// Meeting Notes (User's Personal Notes)
// ========================================

model MeetingNote {
  id              String    @id @default(cuid())
  meetingId       String
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  content         String
  contentHtml     String?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([meetingId])
  @@index([userId])
}

// ========================================
// Tags
// ========================================

model MeetingTag {
  id              String    @id @default(cuid())
  meetingId       String
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  name            String
  color           String?   // Hex color code

  // Timestamps
  createdAt       DateTime  @default(now())

  @@unique([meetingId, name])
  @@index([meetingId])
}

// ========================================
// Vector Embeddings (for Qdrant tracking)
// ========================================

model VectorEmbedding {
  id              String    @id @default(cuid())

  // Reference
  entityType      String    // "meeting", "transcript_line", "summary"
  entityId        String

  // Qdrant metadata (qdrantId is a UUID point id)
  qdrantId        String    @unique
  collectionName  String

  // Embedding metadata
  model           String    @default("gemini")
  dimension       Int       @default(768)

  // Timestamps
  createdAt       DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([qdrantId])
}

// ========================================
// Integration Logs (For tracking exports/shares)
// ========================================

model IntegrationLog {
  id              String    @id @default(cuid())

  // What was shared
  entityType      String    // "meeting", "summary", "transcript"
  entityId        String

  // IntegrationType: SLACK | EMAIL | PDF_EXPORT | MARKDOWN_EXPORT | CALENDAR_SYNC
  integrationType String
  destination     String?   // Channel ID, email address, etc.

  // Status
  status          String    @default("pending") // "pending", "success", "failed"
  error           String?

  // Metadata
  metadata        Json?

  // Timestamps
  createdAt       DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([integrationType])
}
